# Kopiere diese Datei zu ".env" und trage die echten Werte ein.
# Die echten Werte stehen in Vercel (Settings -> Environment Variables)
# und in deiner persoenlichen Notiz. NIEMALS die .env committen!

# Supabase (Frontend - werden ins Browser-Bundle eingebaut)
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Anthropic (nur serverseitig fuer api/analyze.js)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Supabase Secret (serverseitig, aktuell reserviert)
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
